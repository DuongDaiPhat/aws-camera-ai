{
  "info": {
    "name": "Face branch real HTTP regression",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:18082"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "imagePath",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "API-FACE-AUTH-assess: missing token",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/face/assess",
        "body": {
          "mode": "formdata",
          "formdata": []
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));",
              "pm.test(\"unauthorized body\", () => { pm.expect(pm.response.json().detail).to.eql('UNAUTHORIZED'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "API-FACE-AUTH-embed: missing token",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/face/embed",
        "body": {
          "mode": "formdata",
          "formdata": []
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));",
              "pm.test(\"unauthorized body\", () => { pm.expect(pm.response.json().detail).to.eql('UNAUTHORIZED'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "API-FACE-AUTH-match: missing token",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/face/match",
        "body": {
          "mode": "formdata",
          "formdata": []
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));",
              "pm.test(\"unauthorized body\", () => { pm.expect(pm.response.json().detail).to.eql('UNAUTHORIZED'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "API-FACE-AUTH-collection/sync: missing token",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/face/collection/sync",
        "body": {
          "mode": "formdata",
          "formdata": []
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));",
              "pm.test(\"unauthorized body\", () => { pm.expect(pm.response.json().detail).to.eql('UNAUTHORIZED'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "API-FACE-001: assess requires image",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Internal-Token",
            "value": "{{token}}"
          }
        ],
        "url": "{{baseUrl}}/face/assess",
        "body": {
          "mode": "formdata",
          "formdata": []
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 422', () => pm.response.to.have.status(422));",
              "pm.test(\"validation detail\", () => { pm.expect(pm.response.json().detail).to.be.an(\"array\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "API-FACE-002: real R50 assessment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Internal-Token",
            "value": "{{token}}"
          }
        ],
        "url": "{{baseUrl}}/face/assess",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "image",
              "type": "file",
              "src": "{{imagePath}}"
            },
            {
              "key": "includeEmbedding",
              "value": "true",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test(\"gate passes\", () => { pm.expect(pm.response.json().passed).to.eql(true); });",
              "pm.test(\"real R50 model\", () => { pm.expect(pm.response.json().modelVersion).to.eql('yunet-2023mar-w600k-r50'); });",
              "pm.test(\"gate ready\", () => { pm.expect(pm.response.json().gateStatus).to.eql('READY'); });",
              "pm.test(\"normalized 512D embedding\", () => { const b=pm.response.json(); pm.expect(b.embeddingDim).to.eql(512);\n    const bytes=Buffer.from(b.embeddingBase64,'base64'); pm.expect(bytes.length).to.eql(2048);\n    let n=0; for(let i=0;i<512;i++){const x=bytes.readFloatLE(i*4); pm.expect(Number.isFinite(x)).to.eql(true); n+=x*x;}\n    pm.expect(Math.abs(n-1)).to.be.below(0.0001); });"
            ]
          }
        }
      ]
    },
    {
      "name": "API-FACE-003: embedding opt-out",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Internal-Token",
            "value": "{{token}}"
          }
        ],
        "url": "{{baseUrl}}/face/assess",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "image",
              "type": "file",
              "src": "{{imagePath}}"
            },
            {
              "key": "includeEmbedding",
              "value": "false",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test(\"gate passes\", () => { pm.expect(pm.response.json().passed).to.eql(true); });",
              "pm.test(\"real R50 model\", () => { pm.expect(pm.response.json().modelVersion).to.eql('yunet-2023mar-w600k-r50'); });",
              "pm.test(\"gate ready\", () => { pm.expect(pm.response.json().gateStatus).to.eql('READY'); });",
              "pm.test(\"no embedding\", () => { pm.expect(pm.response.json().embeddingBase64).to.eql(null); pm.expect(pm.response.json().embeddingDim).to.eql(null); });"
            ]
          }
        }
      ]
    },
    {
      "name": "API-FACE-004: SFace embed remains compatible",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Internal-Token",
            "value": "{{token}}"
          }
        ],
        "url": "{{baseUrl}}/face/embed",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "image",
              "type": "file",
              "src": "{{imagePath}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test(\"128D contract\", () => { const b=pm.response.json(); pm.expect(b.error).to.eql(null); pm.expect(b.embeddingDim).to.eql(128); pm.expect(Buffer.from(b.embeddingBase64,\"base64\").length).to.eql(512); });"
            ]
          }
        }
      ]
    },
    {
      "name": "API-FACE-BVA--0.01: threshold out of range",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Internal-Token",
            "value": "{{token}}"
          }
        ],
        "url": "{{baseUrl}}/face/match",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "image",
              "type": "file",
              "src": "{{imagePath}}"
            },
            {
              "key": "requestId",
              "value": "00000000-0000-4000-8000-000000000001",
              "type": "text"
            },
            {
              "key": "ownerScopeId",
              "value": "00000000-0000-4000-8000-000000000002",
              "type": "text"
            },
            {
              "key": "collectionVersion",
              "value": "1",
              "type": "text"
            },
            {
              "key": "threshold",
              "value": "-0.01",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 422', () => pm.response.to.have.status(422));",
              "pm.test(\"threshold rejected\", () => { pm.expect(pm.response.json().detail.some(e=>e.loc.includes('threshold'))).to.eql(true); });"
            ]
          }
        }
      ]
    },
