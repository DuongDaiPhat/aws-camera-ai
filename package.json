{
  "name": "aws-camera-ai",
  "version": "0.0.1",
  "private": true,
  "description": "He thong camera giam sat hanh vi ung dung AI va AWS",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "docker compose up -d && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "test": "pnpm -r test",
    "test:cov": "pnpm -r test:cov",
    "setup:ai": "node tools/scripts/py.mjs --setup",
    "lint:ai": "node tools/scripts/py.mjs ruff check .",
    "lint:ai:fix": "node tools/scripts/py.mjs ruff check --fix .",
    "format:ai": "node tools/scripts/py.mjs ruff format .",
    "format:ai:check": "node tools/scripts/py.mjs ruff format --check .",
    "test:ai": "node tools/scripts/py.mjs pytest",
    "check:ai": "pnpm lint:ai && pnpm format:ai:check && pnpm test:ai",
    "check:all": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:tools && pnpm api:lint && pnpm check:ai",
    "typecheck": "pnpm -r typecheck",
    "api:lint": "redocly lint api/openapi.yaml api/openapi-ai-service.yaml",
    "api:preview": "redocly preview-docs api/openapi.yaml",
    "contracts:generate": "pnpm --filter @cam/contracts generate && pnpm --filter @cam/contracts build",
    "contracts:build": "pnpm --filter @cam/contracts build",
    "db:migrate": "node tools/scripts/migrate.mjs up",
    "db:reset": "node tools/scripts/migrate.mjs reset",
    "seed": "node tools/scripts/seed.mjs",
    "frigate:init": "node tools/scripts/frigate-init.mjs",
    "frigate:check": "node tools/scripts/frigate-check.mjs",
    "frigate:validate": "node tools/scripts/frigate-validate.mjs",
    "test:tools": "node --test \"tools/scripts/test/*.test.mjs\"",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@redocly/cli": "^1.25.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "pg": "^8.23.0",
    "prettier": "^3.3.3",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ],
    "*.py": [
      "ruff check --fix",
      "ruff format"
    ]
  }
}
