{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "endOfLine": "lf",
  "overrides": [
    { "files": "*.md", "options": { "printWidth": 100, "proseWrap": "preserve" } },
    { "files": "*.{yaml,yml}", "options": { "singleQuote": false } }
  ]
}
