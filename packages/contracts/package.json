{
  "name": "@cam/contracts",
  "version": "0.0.1",
  "private": true,
  "description": "Kieu du lieu dung chung FE/BE, SINH RA tu api/openapi.yaml",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "openapi-typescript ../../api/openapi.yaml -o ./src/generated/orchestrator.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm build",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "echo \"(contracts - kieu du lieu thuan, khong co runtime test)\""
  },
  "devDependencies": {
    "@cam/eslint-config": "workspace:*",
    "openapi-typescript": "^7.4.1",
    "typescript": "^5.6.2"
  }
}
