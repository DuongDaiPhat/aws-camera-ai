# =====================================================================
# Sao chep file nay thanh .env truoc khi chay `docker compose up`
#   cp .env.example .env      (Linux/macOS)
#   copy .env.example .env    (Windows CMD)
# KHONG BAO GIO commit file .env (NFR-09)
# =====================================================================

COMPOSE_PROJECT_NAME=camerai
TZ=Asia/Ho_Chi_Minh
NODE_ENV=development
LOG_LEVEL=debug

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=camerai
POSTGRES_USER=camerai
POSTGRES_PASSWORD=
DATABASE_URL=

# ---------- MQTT (Mosquitto) ----------
MQTT_URL=mqtt://mosquitto:1883
MQTT_CLIENT_ID=orchestrator
MQTT_TOPIC_FRIGATE=frigate/events
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_RECONNECT_PERIOD_MS=3000
MQTT_CONNECT_TIMEOUT_MS=10000

# ---------- Frigate ----------
# Ten service Docker, khong dung localhost tu ben trong Orchestrator.
FRIGATE_URL=http://frigate:5000
FRIGATE_DEFAULT_CLIP_DURATION_MS=10000

# ---------- Object storage ----------
# STORAGE_PROVIDER: minio | s3   (US-23, FR-DAT-01)
STORAGE_PROVIDER=minio
STORAGE_BUCKET=camerai-media
STORAGE_PRESIGN_TTL_SECONDS=900
EVENT_MEDIA_LIST_LIMIT=100
MINIO_ENDPOINT=http://minio:9000
# Endpoint ma TRINH DUYET goi toi khi mo presigned URL (anh snapshot tren dashboard).
# Trong Docker phai khac MINIO_ENDPOINT vi trinh duyet khong phan giai duoc ten service.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MEDIA_RETENTION_DAYS=7

# ---------- Auth ----------
# AUTH_PROVIDER: jwt | cognito   (US-05 -> US-25)
AUTH_PROVIDER=jwt
JWT_SECRET=
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---------- AI service ----------
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TIMEOUT_MS=5000
# Secret dung chung cho callback noi bo. Dev phai tu dat chuoi ngau nhien >= 32 ky tu.
INTERNAL_SERVICE_TOKEN=
AI_RESULT_MAX_ITEMS=20
AI_RESULT_MAX_METADATA_BYTES=16384
AI_RESULT_MAX_METADATA_DEPTH=5
AI_RESULT_MAX_FUTURE_SECONDS=300
AI_RESULT_OUTBOX_POLL_MS=1000
AI_RESULT_OUTBOX_LEASE_SECONDS=30
AI_RESULT_OUTBOX_RETRY_SECONDS=5
# FACE_PROVIDER: local | rekognition   (US-24, feature flag BAT BUOC)
FACE_PROVIDER=local
FACE_MATCH_THRESHOLD=0.60
AI_INTERNAL_TOKEN=
FACE_MODEL_VERSION=yunet-2023mar-sface-2021dec
FACE_DETECTOR_PATH=models/face_detection_yunet_2023mar.onnx
FACE_EMBEDDER_PATH=models/face_recognition_sface_2021dec.onnx
FACE_MAX_IMAGE_BYTES=5242880
FACE_MAX_REQUEST_BYTES=26214400
FACE_MAX_PIXELS=12000000
FACE_MAX_CONCURRENT=2
FACE_REQUESTS_PER_MINUTE=10
FACE_REGISTRATION_SIMILARITY=0.60
FACE_SYNC_INTERVAL_MS=10000
FALL_IMMOBILITY_SECONDS=15
FIRE_MIN_CONSECUTIVE_FRAMES=3

# ---------- Fire/smoke M3 (US-18) ----------
M3_ENABLED=false
FIRE_MODEL_PATH=models/fire-smoke-yolo26n-checkpoint-nms.onnx
FIRE_MODEL_VERSION=fire-smoke-yolo26n-checkpoint-nms-v1
# Required SHA-256 of the deployed ONNX; never download models during inference.
FIRE_MODEL_SHA256=773e23d1896d82787819f665694bfbc33825081f7f7a0f5fa5b1c6a22cb54650
FIRE_CONFIDENCE_THRESHOLD=0.50
FIRE_OUTPUT_CONFIDENCE_FLOOR=0.10
# Must cover the embedded graph floor in the checksum-bound .contract.json sidecar.
FIRE_CONFIRMATION_WINDOW_SECONDS=5
FIRE_MAX_FRAME_GAP_SECONDS=1
FIRE_CLEAR_SECONDS=10
FIRE_MAX_CONCURRENT_REQUESTS=1
FIRE_MAX_CAMERAS=16
FIRE_MAX_IMAGE_BYTES=1048576
FIRE_MAX_IMAGE_PIXELS=2073600
FIRE_REQUEST_TIMEOUT_MS=2000
FIRE_FRAME_MAX_AGE_SECONDS=1
FIRE_FRAME_FUTURE_TOLERANCE_SECONDS=0.5
FIRE_CPU_THREADS=2
FIRE_STATE_SWEEP_INTERVAL_MS=250
# Runtime health diagnostics (does not relax detector frame freshness).
FIRE_HEALTH_STALE_SECONDS=5
FIRE_HEALTH_TIMEOUT_MS=1000
FIRE_HEALTH_URL=http://localhost:3001/api/v1/internal/fire/health
FIRE_HEALTH_CLIENT_TIMEOUT_MS=10000
FIRE_HEALTH_POLL_MS=5000
FRIGATE_FIRE_FRAMES_ENABLED=false
MQTT_TOPIC_FIRE_FRAMES=frigate/camerai/fire/frames
FIRE_SAMPLE_FPS=5
FIRE_JPEG_QUALITY=85
FIRE_DELIVERY_POLL_MS=1000
FIRE_DELIVERY_LEASE_SECONDS=30
FIRE_DELIVERY_RETRY_SECONDS=5
FIRE_MEDIA_READY_DELAY_SECONDS=15
FIRE_MEDIA_RETRY_SECONDS=30
FIRE_MEDIA_MAX_AGE_DAYS=7
FIRE_CLIP_PRE_SECONDS=5
FIRE_CLIP_POST_SECONDS=5
FIRE_CLIP_TIMEOUT_MS=10000
FIRE_CLIP_MAX_BYTES=33554432
# Applied on camera Frigate sync while M3 and camera recording are enabled.
# Continuous recording supplies the pre-detection video even without person/motion events.
FIRE_CONTINUOUS_RECORDING_DAYS=1

# Isolated video-gate controls, set by tools/scripts/fire-video-gate.mjs only.
# FIRE_VIDEO_MANUAL_REVIEW=true waits for a real dashboard confirmation instead of a browser-driver marker.
# FIRE_VIDEO_REVIEW_WAIT_MS is derived from the runner's --review-minutes argument.

# ---------- Telegram (US-14) ----------
# Chỉ bật sau khi đã cấu hình bot, migration và mapping người nhận đã xác minh.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_TIMEOUT_MS=5000
TELEGRAM_POLL_MS=3000
TELEGRAM_LEASE_SECONDS=30
TELEGRAM_BATCH_SIZE=20
TELEGRAM_MEDIA_WAIT_MS=1000
TELEGRAM_IMAGE_RENDER_TIMEOUT_MS=1500
TELEGRAM_IMAGE_RENDER_MAX_BYTES=2097152
TELEGRAM_IMAGE_RENDER_MAX_BOXES=32
TELEGRAM_IMAGE_BOX_THICKNESS=5
# Optional private JSON for a bounded live test: cameraId, recipientUserId,
# createdAfter, until, maxAttempts. A shared DB attempt budget also bounds retries.
TELEGRAM_DELIVERY_SCOPE=
# Callback/edit workers; delivery retry remains separate from escalation deadline.
TELEGRAM_RETRY_DELAYS_SECONDS=2,4,8
TELEGRAM_CALLBACK_TTL_SECONDS=86400
TELEGRAM_WORK_POLL_MS=1000
TELEGRAM_WORK_LEASE_SECONDS=30
TELEGRAM_WORK_MAX_ATTEMPTS=8
TELEGRAM_WORK_BATCH_SIZE=20
NOTIFY_MAX_ATTEMPTS=3

# ---------- AWS (Sprint 4 - de trong o Sprint 0..3) ----------
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
REKOGNITION_COLLECTION_ID=camerai-known-faces
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
SNS_TOPIC_ARN=
CONNECT_INSTANCE_ID=
CONNECT_CONTACT_FLOW_ID=
CLOUDWATCH_LOG_GROUP=/camerai/dev

# ---------- Ports host ----------
PORT_ORCHESTRATOR=3001
PORT_WEB=3000
PORT_AI=8000
PORT_FRIGATE=5000
PORT_MINIO_API=9000
PORT_MINIO_CONSOLE=9001
PORT_POSTGRES=5432
PORT_MQTT=1883
PORT_RTSP=8554
PORT_WEBRTC_HTTP=8889
PORT_WEBRTC_ICE=8189

# ---------- MediaMTX ----------
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=localhost
MEDIAMTX_RTSP_URL=rtsp://mediamtx:8554
MEDIAMTX_WEBRTC_URL=http://localhost:8889
MEDIAMTX_PUBLISH_USERNAME=cam-internal
MEDIAMTX_PUBLISH_PASSWORD=

# ---------- Camera Sources & Runner (Slice CAM) ----------
CAMERA_SOURCE_START_TIMEOUT_MS=10000
CAMERA_SOURCE_STOP_TIMEOUT_MS=5000
CAMERA_SOURCE_MAX_RETRIES=3
CAMERA_SOURCE_RETRY_DELAY_MS=2000
CAMERA_RTSP_TEST_TIMEOUT_MS=8000
CAMERA_DETECTION_TTL_MS=10000
MQTT_TOPIC_CAMERA_FRAMES=frigate/camerai/frames
CAMERA_VIDEO_MAX_BYTES=524288000
CAMERA_VIDEO_STORAGE_PATH=./storage/videos

# ---------- Frontend ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
# Refresh evidence links and pending fire alerts even without new SSE messages.
NEXT_PUBLIC_FIRE_DETAIL_REFRESH_MS=30000
NEXT_PUBLIC_FIRE_DETAIL_RETRY_MS=3000
NEXT_PUBLIC_FIRE_ATTENTION_POLL_MS=10000
# Interruptions expire three hours after detection; group nearby detections on the same camera.
NEXT_PUBLIC_FIRE_ATTENTION_MAX_AGE_MS=10800000
NEXT_PUBLIC_FIRE_ATTENTION_EPISODE_GAP_MS=300000
NEXT_PUBLIC_EVENTS_REFRESH_MS=60000
# The local webcam Compose override enables WATCHPACK_POLLING=true for Windows bind mounts.
WEB_ORIGIN=http://localhost:3000

# ---------- US-20 wellness (admission off by default) ----------
M5_ENABLED=false
WELLNESS_POLL_INTERVAL_MS=5000
WELLNESS_BATCH_SIZE=50
WELLNESS_RUN_LEASE_SECONDS=30
WELLNESS_CATCHUP_SECONDS=300
WELLNESS_RECONCILE_LOOKBACK_SECONDS=86400
WELLNESS_DELIVERY_TIMEOUT_SECONDS=60
WELLNESS_PRESENCE_TTL_SECONDS=86400
WELLNESS_IDENTITY_LINK_TTL_SECONDS=30
WELLNESS_OBSERVATION_MAX_AGE_SECONDS=86400
WELLNESS_CLOCK_SKEW_SECONDS=5
WELLNESS_DIRECTION_SAMPLES=2
WELLNESS_BOUNDARY_MARGIN=0.01
WELLNESS_MAX_TRACK_STATES=2048
WELLNESS_MAX_PENDING_FRAMES=2
WELLNESS_MAX_FRAME_OBJECTS=64
WELLNESS_SOURCE_PRUNE_INTERVAL_MS=60000
WELLNESS_SOURCE_PRUNE_BATCH_SIZE=10000
# Normalized boundary axis/position, explicit inside side; no boundary means no departure inference.
# Example: [{"cameraSlug":"front_door","boundaryId":"door","axis":"x","position":0.5,"inside":"less","policyVersion":"v1"}]
WELLNESS_BOUNDARIES_JSON=[]
